package templates

import (
	"fmt"
	"time"
)

// Book is a single book's page under the reading section, the work with
// its oldest copy merged in above every read of it.
templ Book(v BookView) {
	@Layout(docTitle(v.Title), "/reading") {
		<div class="mx-auto max-w-measure">
			<header class="mb-10">
				<div class="flex flex-wrap items-baseline gap-x-3">
					<span class="font-mono text-kicker tracking-kicker text-fainter">{ v.Kind }</span>
					if v.Series != "" {
						<span class="font-mono text-meta text-faint">{ v.Series }</span>
					}
				</div>
				<h1 class="mt-3 font-serif italic text-display text-fg leading-tight tracking-tight">{ v.Title }</h1>
				if v.OriginalTitle != "" {
					<p class="mt-1.5 font-serif text-body text-faint italic leading-snug">({ v.OriginalTitle })</p>
				}
				if v.Authors != "" {
					<p class="mt-2 font-sans text-lead text-muted">{ v.Authors }</p>
				}
				if v.Translators != "" {
					<p class="mt-1 font-sans text-label text-faint">{ v.Translators }</p>
				}
			</header>
			@bookPlate(v)
			<section class="mt-12">
				@sectionHead("Reads", v.Head)
				if len(v.Reads) > 0 {
					<div class="space-y-4">
						for _, r := range v.Reads {
							@bookReadCard(r)
						}
					</div>
				} else {
					<p class="font-serif italic text-muted">{ v.UnreadNote }</p>
				}
			</section>
			<div class="mt-12">
				@indexLink("/reading", "Back to reading")
			</div>
		</div>
	}
}

// bookPlate is the book's frontispiece, the cover standing free beside
// the work's facts in a boxed stat grid with the tags beneath it.
templ bookPlate(v BookView) {
	<div class="flex flex-col gap-8 lg:flex-row lg:items-stretch lg:gap-10">
		if v.ImageURL != "" {
			<img src={ v.ImageURL } alt="" class="w-auto max-h-96 max-w-full self-start border border-rule object-contain"/>
		} else {
			<div class="flex aspect-2/3 w-48 items-center justify-center self-start border border-rule">
				<span class="px-4 text-center font-serif italic text-body text-ghost">No cover</span>
			</div>
		}
		<div class="flex min-w-0 flex-1 flex-col">
			<dl class="grid grid-cols-2 gap-px border border-fg bg-rule-soft">
				for i, f := range v.Facts {
					<div class={ "bg-surface p-5", bookFactSpan(i, len(v.Facts)) }>
						<dt class="font-mono text-kicker tracking-kicker uppercase text-fainter">{ f.Label }</dt>
						<dd class="mt-1.5 font-sans text-h2 text-fg tabular-nums leading-none">{ f.Value }</dd>
					</div>
				}
			</dl>
			if len(v.Tags) > 0 {
				<div class="mt-3 flex flex-wrap gap-2">
					for _, t := range v.Tags {
						<span class="font-mono text-meta text-muted border border-rule-soft p-2 leading-none">{ t }</span>
					}
				</div>
			}
		</div>
	</div>
}

// bookFactSpan is the grid classes for a fact, the last one spanning the
// full row when the count is odd so the grid never leaves a gap.
func bookFactSpan(i, n int) string {
	if i != n-1 || n%2 == 0 {
		return ""
	}
	return "col-span-2"
}

// readRow is one leader row on a read card, a label, a value, and an
// optional muted note run on from the value.
type readRow struct {
	Label string
	Value string
	Note  string
}

// bookReadCard is one read as a card, headed by its period with the
// rating, or by the progress bar when still open.
templ bookReadCard(r BookReadView) {
	<article class="border border-rule-soft p-6">
		if r.Status == "reading" {
			@bookReadProgress(r)
			@bookReadRows(bookReadMeta(r), true)
		} else {
			<div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-rule pb-4">
				<p class="font-serif text-lead italic text-fg tabular-nums">
					if !r.StartedAt.IsZero() && !r.FinishedAt.IsZero() {
						{ fmtDate(r.StartedAt) }
						if !sameDay(r.StartedAt, r.FinishedAt) {
							<span class="text-faint">&rarr;</span>
							{ fmtDate(r.FinishedAt) }
						}
					} else if !r.FinishedAt.IsZero() {
						{ fmtDate(r.FinishedAt) }
					} else if !r.StartedAt.IsZero() {
						{ fmtDate(r.StartedAt) }
						if r.Status == "abandoned" {
							<span class="text-faint">&rarr;</span>
							set aside
						}
					}
				</p>
				if r.Rating > 0 {
					@ratingMeter(r.Rating)
				} else {
					<span class="font-mono text-meta text-faint">unrated</span>
				}
			</div>
			@bookReadRows(bookReadMeta(r), false)
		}
	</article>
}

// bookReadRows are the read's leader rows, ruled off with a hairline when
// they follow the progress bar.
templ bookReadRows(rows []readRow, divided bool) {
	if len(rows) > 0 {
		<ul class={ "mt-5 space-y-2.5", templ.KV("border-t border-rule pt-5", divided) }>
			for _, m := range rows {
				<li class="flex items-baseline gap-3">
					<span class="shrink-0 font-mono text-meta text-faint">{ m.Label }</span>
					<span class="grow border-b border-dotted border-rule"></span>
					<span class="text-right font-mono text-label text-fg tabular-nums">
						{ m.Value }
						if m.Note != "" {
							<span class="ml-1 font-serif text-label text-faint italic">({ m.Note })</span>
						}
					</span>
				</li>
			}
		</ul>
	}
}

// bookReadProgress is the open read's desk block, heading the card in
// place of a period.
templ bookReadProgress(r BookReadView) {
	<div>
		<div class="mb-1.5 flex items-baseline justify-between font-mono text-label text-fg tabular-nums">
			if r.CurrentPage > 0 && r.Pages > 0 {
				<span>page { fmt.Sprintf("%d", r.CurrentPage) } of { fmt.Sprintf("%d", r.Pages) }</span>
			} else if r.Pages > 0 {
				<span>{ fmt.Sprintf("%d", r.Pages) } pages</span>
			} else {
				<span></span>
			}
			<span>{ fmt.Sprintf("%d%%", r.Percent) }</span>
		</div>
		<div class="h-1.5 w-full bg-rule">
			<div class="h-full bg-accent" style={ fmt.Sprintf("width:%d%%", r.Percent) }></div>
		</div>
		<div class="mt-2.5 flex flex-wrap items-center gap-x-3 font-mono text-meta text-faint">
			if !r.StartedAt.IsZero() {
				<span>since { fmtDate(r.StartedAt) }</span>
			}
			if r.DayCount > 0 {
				if !r.StartedAt.IsZero() {
					<span class="-ml-3"><span class="text-ghost">;</span> day { fmt.Sprintf("%d", r.DayCount) }</span>
				} else {
					<span>day { fmt.Sprintf("%d", r.DayCount) }</span>
				}
			}
		</div>
	</div>
}

// bookReadMeta is the read's facts as leader rows, each left out when
// unrecorded.
func bookReadMeta(r BookReadView) []readRow {
	var meta []readRow
	if r.Edition != "" {
		meta = append(meta, readRow{Label: "edition", Value: r.Edition})
	}
	if r.Format != "" {
		meta = append(meta, readRow{Label: "format", Value: r.Format})
	}
	if r.Language != "" {
		meta = append(meta, readRow{Label: "language", Value: r.Language})
	}
	if r.Source != "" || r.SecondHand {
		row := readRow{Label: "source", Value: r.Source}
		if r.SecondHand {
			row.Note = "second-hand"
		}
		meta = append(meta, row)
	}
	if r.Days > 0 {
		meta = append(meta, readRow{Label: "took", Value: fmt.Sprintf("%d %s", r.Days, plural(r.Days, "day"))})
	}
	if r.Pace != "" {
		meta = append(meta, readRow{Label: "pace", Value: r.Pace})
	}
	return meta
}

// sameDay reports whether two times fall on the same calendar day.
func sameDay(a, b time.Time) bool {
	ay, am, ad := a.Date()
	by, bm, bd := b.Date()
	return ay == by && am == bm && ad == bd
}
