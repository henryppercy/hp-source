package templates

import (
	"fmt"
	"time"
)

// Book is a single book's page under the reading section, the work with
// its oldest copy merged in above every read of it.
templ Book(v BookView) {
	@Layout(docTitle(v.Title), "/reading") {
		<div class="mx-auto max-w-measure">
			<header class="mb-10">
				if v.Series != "" {
					if v.SeriesURL != "" {
						<a href={ v.SeriesURL } class="font-mono text-meta text-faint hover:text-accent">{ v.Series }</a>
					} else {
						<span class="font-mono text-meta text-faint">{ v.Series }</span>
					}
				}
				<h1 class={ "font-serif italic text-display text-fg leading-tight tracking-tight", templ.KV("mt-2", v.Series != "") }>{ v.Title }</h1>
				if v.OriginalTitle != "" {
					<p class="font-serif text-body text-faint italic leading-snug">({ v.OriginalTitle })</p>
				}
				if len(v.Credits) > 0 {
					<p class="mt-3 font-sans text-lead text-muted">
						for i, c := range v.Credits {
							if i > 0 {
								<span class="text-faint">, </span>
							}
							if c.URL != "" {
								<a href={ c.URL } class="hover:text-accent">{ c.Name }</a>
							} else {
								{ c.Name }
							}
							if c.Role != "" {
								<span class="text-faint">({ c.Role })</span>
							}
						}
					</p>
				}
				if v.Translators != "" {
					<p class="font-sans text-label text-faint">{ v.Translators }</p>
				}
			</header>
			@bookPlate(v)
			<section class="mt-12">
				@sectionHead("Reads", v.Head)
				if len(v.Reads) > 0 {
					<div class="space-y-4">
						for _, r := range v.Reads {
							@bookReadCard(r)
						}
					</div>
				} else {
					<p class="font-serif italic text-muted">{ v.UnreadNote }</p>
				}
			</section>
			<div class="mt-12">
				@indexLink("/reading", "Back to reading")
			</div>
		</div>
	}
}

// bookPlate is the book's frontispiece, the cover standing free beside
// the work's facts in a typed box with the tags beneath it.
templ bookPlate(v BookView) {
	<div class="flex flex-col gap-8 lg:flex-row lg:items-stretch lg:gap-10">
		if v.ImageURL != "" {
			<img src={ v.ImageURL } alt="" class="w-auto max-h-96 max-w-full self-start border border-rule object-contain"/>
		} else {
			<div class="flex aspect-2/3 w-48 items-center justify-center self-start border border-rule">
				<span class="px-4 text-center font-serif italic text-body text-ghost">No cover</span>
			</div>
		}
		<div class="flex min-w-0 flex-1 flex-col">
			<dl class="grid grid-cols-2 gap-px border border-fg bg-rule-soft">
				for i, f := range v.Facts {
					<div class={ "bg-surface p-4", bookFactSpan(i, len(v.Facts)) }>
						<dt class="font-mono text-kicker tracking-kicker uppercase text-fainter">{ f.Label }</dt>
						<dd class="mt-1 font-mono text-lead text-fg tabular-nums">
							if f.URL != "" {
								<a href={ f.URL } class="hover:text-accent">{ f.Value }</a>
							} else {
								{ f.Value }
							}
						</dd>
					</div>
				}
			</dl>
			if v.Kind != "" || len(v.Tags) > 0 {
				<div class="mt-3 flex flex-wrap gap-2">
				if v.Kind != "" {
					if v.KindURL != "" {
						<a href={ v.KindURL } class="font-mono text-meta text-muted border border-rule-soft p-2 leading-none hover:border-fg">{ v.Kind }</a>
					} else {
						<span class="font-mono text-meta text-muted border border-rule-soft p-2 leading-none">{ v.Kind }</span>
					}
				}
					for _, t := range v.Tags {
						if t.URL != "" {
							<a href={ t.URL } class="font-mono text-meta text-muted border border-rule-soft p-2 leading-none hover:border-fg">{ t.Name }</a>
						} else {
							<span class="font-mono text-meta text-muted border border-rule-soft p-2 leading-none">{ t.Name }</span>
						}
					}
				</div>
			}
		</div>
	</div>
}

// bookFactSpan is the grid classes for a typed box cell, the last one
// spanning the full row when the count is odd so no box shows an empty
// grey half.
func bookFactSpan(i, n int) string {
	if i != n-1 || n%2 == 0 {
		return ""
	}
	return "col-span-2"
}

// readField is one typed field on a read card, a printed kicker over a
// value the reader wrote in. Every field on a read describes the copy
// rather than the work, so none of them are preprinted.
type readField struct {
	Label string
	Value string
	Note  string
}

// bookReadCard is one read as a typed box, opening on a full-width cell
// whose kicker is the status and whose value is the written-in period with
// the rating pips, or the progress bar while still open, over the read's
// facts as kicker and value cells.
templ bookReadCard(r BookReadView) {
	<dl class="grid grid-cols-2 gap-px border border-fg bg-rule-soft">
		<div class="col-span-2 bg-surface p-4">
			<dt class="font-mono text-kicker tracking-kicker uppercase text-fainter">{ bookReadKicker(r.Status) }</dt>
			if r.Status == "reading" {
				<dd class="mt-2">
					@bookReadProgress(r)
				</dd>
			} else {
				<dd class="mt-1 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
					<p class="font-serif text-lead italic text-fg tabular-nums">
						if !r.StartedAt.IsZero() && !r.FinishedAt.IsZero() {
							{ fmtDate(r.StartedAt) }
							if !sameDay(r.StartedAt, r.FinishedAt) {
								<span class="text-faint">&rarr;</span>
								{ fmtDate(r.FinishedAt) }
							}
						} else if !r.FinishedAt.IsZero() {
							{ fmtDate(r.FinishedAt) }
						} else if !r.StartedAt.IsZero() {
							{ fmtDate(r.StartedAt) }
							if r.Status == "abandoned" {
								<span class="text-faint">&rarr;</span>
								set aside
							}
						}
					</p>
					if r.Rating > 0 {
						@ratingMeter(r.Rating)
					} else {
						<span class="font-mono text-meta text-faint">unrated</span>
					}
				</dd>
			}
		</div>
		@bookReadFields(bookReadMeta(r))
	</dl>
}

// bookReadFields are the read's typed fields as cells under the opening
// one, the last field spanning its row when the count is odd.
templ bookReadFields(fields []readField) {
	for i, f := range fields {
		<div class={ "bg-surface p-4", bookFactSpan(i, len(fields)) }>
			<dt class="font-mono text-kicker tracking-kicker uppercase text-fainter">{ f.Label }</dt>
			<dd class="mt-1 font-serif italic text-label text-fg">
				{ f.Value }
				if f.Note != "" {
					<span class="ml-1 font-serif text-label text-faint italic">({ f.Note })</span>
				}
			</dd>
		</div>
	}
}

// bookReadKicker is the status word that opens a read card's first cell.
func bookReadKicker(status string) string {
	switch status {
	case "reading":
		return "reading"
	case "abandoned":
		return "set aside"
	}
	return "read"
}

// bookReadProgress is the open read's desk block, the page and percent as
// printed figures over the accent bar with the since and day notes written
// in beneath.
templ bookReadProgress(r BookReadView) {
	<div>
		<div class="mb-1.5 flex items-baseline justify-between font-mono text-label text-fg tabular-nums">
			if r.CurrentPage > 0 && r.Pages > 0 {
				<span>page { fmt.Sprintf("%d", r.CurrentPage) } of { fmt.Sprintf("%d", r.Pages) }</span>
			} else if r.Pages > 0 {
				<span>{ fmt.Sprintf("%d", r.Pages) } pages</span>
			} else {
				<span></span>
			}
			<span>{ fmt.Sprintf("%d%%", r.Percent) }</span>
		</div>
		<div class="h-1.5 w-full bg-rule">
			<div class="h-full bg-accent" style={ fmt.Sprintf("width:%d%%", r.Percent) }></div>
		</div>
		<div class="mt-2.5 flex flex-wrap items-baseline gap-x-3 font-serif text-label text-faint italic tabular-nums">
			if !r.StartedAt.IsZero() {
				<span>since { fmtDate(r.StartedAt) }</span>
			}
			if r.DayCount > 0 {
				if !r.StartedAt.IsZero() {
					<span class="-ml-3"><span class="text-ghost">;</span> day { fmt.Sprintf("%d", r.DayCount) }</span>
				} else {
					<span>day { fmt.Sprintf("%d", r.DayCount) }</span>
				}
			}
		</div>
	</div>
}

// bookReadMeta is the read's facts as typed fields, each left out when
// unrecorded, all written in by hand as the copy's facts.
func bookReadMeta(r BookReadView) []readField {
	var fields []readField
	if r.Edition != "" {
		fields = append(fields, readField{Label: "edition", Value: r.Edition})
	}
	if r.Format != "" {
		fields = append(fields, readField{Label: "format", Value: r.Format})
	}
	if r.Language != "" {
		fields = append(fields, readField{Label: "language", Value: r.Language})
	}
	if r.Source != "" || r.SecondHand {
		f := readField{Label: "source", Value: r.Source}
		if r.SecondHand {
			f.Note = "second-hand"
		}
		fields = append(fields, f)
	}
	if r.Days > 0 {
		fields = append(fields, readField{Label: "took", Value: fmt.Sprintf("%d %s", r.Days, plural(r.Days, "day"))})
	}
	if r.Pace != "" {
		fields = append(fields, readField{Label: "pace", Value: r.Pace})
	}
	return fields
}

// sameDay reports whether two times fall on the same calendar day.
func sameDay(a, b time.Time) bool {
	ay, am, ad := a.Date()
	by, bm, bd := b.Date()
	return ay == by && am == bm && ad == bd
}
